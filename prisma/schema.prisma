generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model RateSubmission {
  id           String   @id @default(cuid())
  bankSlug     String
  accountType  String
  proposedRate Float
  sourceUrl    String?
  userEmail    String?
  status       String   @default("pending_review")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}